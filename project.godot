; Engine configuration file.
; Overlord – Herrscher von Nazarick (Godot 4.3+)

config_version=5

[application]

config/name="Overlord – Herrscher von Nazarick"
config/description="Management- & Story-Spiel im Großen Grab von Nazarick."
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Content="*res://scripts/autoload/content.gd"
World="*res://scripts/autoload/world.gd"
Military="*res://scripts/autoload/military.gd"
Diplomacy="*res://scripts/autoload/diplomacy.gd"
Progress="*res://scripts/autoload/progress.gd"
PortraitStudio="*res://scripts/autoload/portrait_studio.gd"
Game="*res://scripts/autoload/game.gd"
Quests="*res://scripts/autoload/quests.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/nazarick_theme.tres"

[rendering]

mesh_lod/lod_change/threshold_pixels=2.0
occlusion_culling/use_occlusion_culling=true

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.02, 0.05, 1)

[shader_globals]

overlord_ground_h={
"type": "sampler2D",
"value": ""
}
overlord_ground_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
overlord_floor_y={
"type": "float",
"value": 0.0
}
overlord_weather={
"type": "vec4",
"value": Vector4(0.3, 0, 0.5, 0.7)
}
overlord_roofs={
"type": "vec4",
"value": Vector4(0.3, 0.3, 0.25, 0.15)
}
